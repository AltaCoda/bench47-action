{
  "name": "bench47-action",
  "version": "1.0.1",
  "private": true,
  "description": "Ask a Bench47 gate, post a sign-off or start a hook from a GitHub workflow.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
